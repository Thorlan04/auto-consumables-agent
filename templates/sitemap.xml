<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

    <!-- Pages d'Accueil Internationales (12 Langues) -->
    {% for lang_code, lang_path in [
        ('fr', '/index.html'),
        ('en', '/en/index.html'),
        ('es', '/es/index.html'),
        ('de', '/de/index.html'),
        ('it', '/it/index.html'),
        ('nl', '/nl/index.html'),
        ('pl', '/pl/index.html'),
        ('pt', '/pt/index.html'),
        ('sv', '/sv/index.html'),
        ('ja', '/ja/index.html'),
        ('zh', '/zh/index.html'),
        ('ar', '/ar/index.html')
    ] %}
    <url>
        <loc>{{ site_url }}{{ lang_path }}</loc>
        <xhtml:link rel="alternate" hreflang="fr" href="{{ site_url }}/index.html"/>
        <xhtml:link rel="alternate" hreflang="en" href="{{ site_url }}/en/index.html"/>
        <xhtml:link rel="alternate" hreflang="es" href="{{ site_url }}/es/index.html"/>
        <xhtml:link rel="alternate" hreflang="de" href="{{ site_url }}/de/index.html"/>
        <xhtml:link rel="alternate" hreflang="it" href="{{ site_url }}/it/index.html"/>
        <xhtml:link rel="alternate" hreflang="nl" href="{{ site_url }}/nl/index.html"/>
        <xhtml:link rel="alternate" hreflang="pl" href="{{ site_url }}/pl/index.html"/>
        <xhtml:link rel="alternate" hreflang="pt" href="{{ site_url }}/pt/index.html"/>
        <xhtml:link rel="alternate" hreflang="sv" href="{{ site_url }}/sv/index.html"/>
        <xhtml:link rel="alternate" hreflang="ja" href="{{ site_url }}/ja/index.html"/>
        <xhtml:link rel="alternate" hreflang="zh" href="{{ site_url }}/zh/index.html"/>
        <xhtml:link rel="alternate" hreflang="ar" href="{{ site_url }}/ar/index.html"/>
        <xhtml:link rel="alternate" hreflang="x-default" href="{{ site_url }}/en/index.html"/>
        <lastmod>{{ now_iso }}</lastmod>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
    </url>
    {% endfor %}

