    <!-- Guides et Fiches Techniques par Appareil (12 Langues par Modèle) -->
    {% for guide in guides %}
        {% for lang_code, prefix in [
            ('fr', ''),
            ('en', '/en'),
            ('es', '/es'),
            ('de', '/de'),
            ('it', '/it'),
            ('nl', '/nl'),
            ('pl', '/pl'),
            ('pt', '/pt'),
            ('sv', '/sv'),
            ('ja', '/ja'),
            ('zh', '/zh'),
            ('ar', '/ar')
        ] %}
    <url>
        <loc>{{ site_url }}{{ prefix }}/guides/{{ guide.slug }}.html</loc>
        <xhtml:link rel="alternate" hreflang="fr" href="{{ site_url }}/guides/{{ guide.slug }}.html"/>
        <xhtml:link rel="alternate" hreflang="en" href="{{ site_url }}/en/guides/{{ guide.slug }}.html"/>
